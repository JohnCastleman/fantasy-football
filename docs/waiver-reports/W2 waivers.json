      "cells": [
        {
          "segments": [
            {
              "text": "NOTE: If you are on this patreon you likely drafted WRs thru the flex plus 1 or 2 thru 10 rounds. If you have multiple Top 30ish WR options on your bench feel free to cut these bids in half. No need to sell out for players who will never crack your lineup.",
              "bold": false,
              "italic": true,
              "newline": false
            },
            {
              "text": "KEY:(YPRR=Yards Per Route Run, TPRR=Targets Per Route Run, XPPG=Expected Points Per Game)",
